{
  "name": "amuguna-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "predev": "node scripts/copy-shared.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-shared.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test src/lib/*.test.mjs ingest/tests/*.test.ts",
    "test:ingest": "tsx --test ingest/tests/*.test.ts",
    "ingest": "node --env-file-if-exists=.env.local --import tsx ingest/cli.ts",
    "typecheck": "tsc --noEmit",
    "coldstart:eta": "node scripts/coldstart-eta.mjs",
    "measure:duplicates": "node scripts/measure-duplicates.mjs",
    "sync:shared": "node scripts/copy-shared.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
