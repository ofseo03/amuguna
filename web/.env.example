# Next.js / Postgres
DATABASE_URL=
SESSION_SECRET=replace-with-openssl-rand-hex-32
PGSSLROOTCERT=

# Rate limit (SPEC §8) — 비우면 기본값. 재배포 없이 값만 바꾸면 즉시 반영된다.
#   세션 = 개인 단위 실질 한도 / IP = 세션 쿠키 회전 abuse 만 막는 NAT 안전망
#   심사 구간(9/7~9/11)에 NAT 뒤 대량 접속이 걱정되면 IP 쪽을 올리거나 0(해제)으로 둔다.
RATE_LIMIT_SESSION_PER_MIN=10
#   세션 쿠키가 없는 요청은 IP 단위 익명 한도를 쓴다 (개인 한도를 IP 로 물리면 NAT 차단,
#   축을 아예 빼면 쿠키만 지워도 IP 한도를 다 쓰게 된다)
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_IP_PER_MIN=600

# TypeScript 수집 배치
DATA_GO_KR_API_KEY=
BIZINFO_API_KEY=
FINLIFE_API_KEY=

# Vercel Next.js 런타임 — 최초 전체 검색 결과 상위 5건의 실시간 답변
OPENROUTER_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
MOCK_EMBEDDINGS=
