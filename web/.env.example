# Next.js / Postgres
DATABASE_URL=
SESSION_SECRET=replace-with-openssl-rand-hex-32
PGSSLROOTCERT=

# Rate limit (SPEC §8) — 비우면 기본값. 재배포 없이 값만 바꾸면 즉시 반영된다.
#   세션 = 개인 단위 실질 한도 / IP = 세션 쿠키 회전 abuse 만 막는 NAT 안전망
#   심사 구간(9/7~9/11)에 NAT 뒤 대량 접속이 걱정되면 IP 쪽을 올리거나 0(해제)으로 둔다.
RATE_LIMIT_SESSION_PER_MIN=10
RATE_LIMIT_IP_PER_MIN=600

# TypeScript 수집 배치
DATA_GO_KR_API_KEY=
BIZINFO_API_KEY=
FINLIFE_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
# 기본 모델이 재시도까지 소진되면 순서대로 시도할 대체 모델 (쉼표 구분).
# 기본값은 비어 있다 — 검증하지 않은 모델 ID 를 넣으면 폴백이 있는 것처럼 보이면서 404 로 실패한다.
# OpenRouter 모델 목록에서 실제 사용 가능한 ID 를 확인해 채운다. 유료 소형 모델 1종을
# 최후 폴백으로 두면 무료 티어가 통째로 죽어도 배치가 완주한다.
LLM_FALLBACK_MODELS=
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
MOCK_EMBEDDINGS=
